# Gemini API key: enables the live AI host voice, generated theme packs,
# AI clip analysis, TTS fallback and semantic answer judging.
# Without it the game still runs (built-in 80s/90s packs, browser speech, subtitles).
GEMINI_API_KEY=

# Optional model overrides.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
HOST_VOICE=Kore

# Packs are built from streaming catalogs (no language model needed). These themes — plus every
# genre/folder your local music covers — are built and cached at launch and whenever the music
# folder changes. Also: npm run prebuild-packs [theme ...]
PREBUILD_THEMES=The 80s,The 90s,Pop,Rock,Hip Hop,Country

# Local music collection: fallback source, or preferred when PREFER_LOCAL_MEDIA=true.
# Files named "Artist - Title.mp3" (any subfolder); subfolder names and genre tags become themes.
# The Settings drawer reads and writes these two lines.
LOCAL_SONGS_DIR=
PREFER_LOCAL_MEDIA=false

# Clip pipeline. Exact sources (the catalog preview URL, a local file) are fetched first; these
# searching providers run only when a curated entry has no preview URL:
#   itunes (30s previews) | deezer (30s previews) | ytdlp (full track, needs yt-dlp; slow) | mock
CLIP_PROVIDERS=itunes,deezer
# Hook mode only: auto = Gemini analyses full-length sources, previews use a local loudness scan.
CLIP_ANALYSIS=auto
# CLIP_CONCURRENCY=4
# PREWARM_BUILTIN_PACKS=true
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# CLIP_MAX_SOURCE_SECONDS=720
# PARTY_HOST_CACHE_DIR=.cache

# Set to "mock" for an offline demo: fake live host, synthetic clips, deterministic packs.
# PARTY_HOST_MODE=mock
# PORT=3000
