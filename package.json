{
  "name": "ai-party-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mock": "PARTY_HOST_MODE=mock tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', '.cache-e2e', 'test-results', 'playwright-report']) rmSync(path, { recursive: true, force: true });\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts server/**/*.test.ts server/*.test.ts",
    "test:e2e": "playwright test --project core",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "sfx": "python3 scripts/generate-sfx.py",
    "prebuild-packs": "tsx scripts/prebuild-packs.ts",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
